Manifest(
    tick_rate: 60,
    model: "wasm-test.aseprite",
    wasm_module: Some((path: "../examples/wasm-adder/target/wasm32-unknown-unknown/release/coppervox_wasm_adder.wasm")),
    mapping: (
        voxel_ident: COLOR,
        components: {
            // Keyboard Inputs
            "#bbc840": (
                type: INPUT_KEY(key: Q, value: 0xFFFFFFFF),
                gradient: 0,
            ),
            "#b14863": (
                type: INPUT_KEY(key: W, value: 0xFFFFFFFF),
                gradient: 0,
            ),

            // WASM IO
            "#ede6c8": (type: WASM_INPUT (0), gradient: 0),
            "#cd9373": (type: WASM_INPUT (1), gradient: 0),
            "#8fbfd5": (type: WASM_OUTPUT(0), gradient: 0),
        }
    ),
    color_gradients: [
        (off: "#111111", low: "#222222", high: "#FFFFFF"),
    ]
)
