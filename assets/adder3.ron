Config(
    tick_rate: 60,
    mapping: (
        voxel_ident: COLOR,
        components: {
            // Components
            "#ffffff": (type: OR  , gradient: (off: "#111111", low: "#222222", high: "#ffffff")),
            "#dc392d": (type: NAND, gradient: (off: "#110000", low: "#220000", high: "#ffa300")),
            "#6ea92c": (type: NAND, gradient: (off: "#000011", low: "#001122", high: "#29adff")),
            "#1651dd": (type: NAND, gradient: (off: "#001100", low: "#002200", high: "#00e436")),

            // Keyboard Inputs
            "#60748a": (
                type: INPUT_KEY(key: Q, value: 0xFFFFFFFF),
                gradient: 0,
            ),
            "#355278": (
                type: INPUT_KEY(key: W, value: 0xFFFFFFFF),
                gradient: 0,
            ),
            "#898989": (
                type: INPUT_KEY(key: E, value: 0xFFFFFFFF),
                gradient: 0,
            ),

            // WASM IO
            "#ffff00": (type: WASM_INPUT (0), gradient: 0),
            "#00ffff": (type: WASM_INPUT (1), gradient: 0),
            "#ff00ff": (type: WASM_OUTPUT(0), gradient: 0),
        }
    ),
    color_gradients: [
        (off: "#111111", low: "#222222", high: "#FFFFFF"),
    ]
)
