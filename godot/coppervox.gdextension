[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64     = "res://../rust/target/debug/libcoppervox_godot.so"
linux.release.x86_64   = "res://../rust/target/release/libcoppervox_godot.so"
windows.debug.x86_64   = "res://../rust/target/debug/coppervox_godot.dll"
windows.release.x86_64 = "res://../rust/target/release/coppervox_godot.dll"
macos.debug            = "res://../rust/target/debug/libcoppervox_godot.dylib"
macos.release          = "res://../rust/target/release/libcoppervox_godot.dylib"
macos.debug.arm64      = "res://../rust/target/debug/libcoppervox_godot.dylib"
macos.release.arm64    = "res://../rust/target/release/libcoppervox_godot.dylib"