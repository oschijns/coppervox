

# Run the main program
run *ARGS:
    cargo run --package coppervox-app --release -- {{ARGS}}


# Run bit adder example
run-adder:
    cargo run --package coppervox-app -- assets/adder3.ron


# Run Goxel circuit
run-goxel:
    cargo run --package coppervox-app -- assets/adder.ron

# Build the wasm adder example
[working-directory: "examples/wasm-adder"]
build-wasm-adder:
    cargo build --package coppervox-wasm-adder --release --target wasm32-unknown-unknown

# Run the WASM adder example
run-wasm-adder: build-wasm-adder
    cargo run --package coppervox-app -- assets/wasm-test.ron
